<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.java</groupId>
        <artifactId>jvnet-parent</artifactId>
        <version>1</version>
    </parent>

    <groupId>org.glassfish.web</groupId>
    <artifactId>jstl</artifactId>
    <version>1.2</version>
    <packaging>pom</packaging>
    <name>GlassFish JSTL related modules</name>

    <developers>
        <developer>
            <id>kchung</id>
            <name>Kin Man Chung</name>
            <url>http://blogs.sun.com/kchung/</url>
            <organization>Oracle Corporation</organization>
            <roles>
                <role>lead</role>
            </roles>
        </developer>
    </developers>

    <url>http://jstl.java.net</url>
    <organization>
        <name>GlassFish Community</name>
        <url>http://glassfish.org</url>
    </organization>
    <licenses>
        <license>
            <name>CDDL + GPLv2 with classpath exception</name>
            <url>https://glassfish.dev.java.net/nonav/public/CDDL+GPL.html</url>
            <distribution>repo</distribution>
            <comments>A business-friendly OSS license</comments>
        </license>
    </licenses>
    <issueManagement>
        <system>jira</system>
        <url>http://java.net/jira/browse/jstl</url>
    </issueManagement>
    <mailingLists>
        <mailingList>
            <name>JSTL Developer</name>
            <archive>dev@jstl.java.net</archive>
        </mailingList>
    </mailingLists>
    <scm>
        <connection>scm:svn:https://svn.java.net/svn/jstl~svn/tags/jstl-1.2</connection>
        <developerConnection>scm:svn:https://svn.java.net/svn/jstl~svn/tags/jstl-1.2</developerConnection>
        <url>http://java.net/projects/jstl/sources/svn/show/tags/jstl-1.2</url>
    </scm>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                </plugin>
                <plugin>
                    <!-- Upstream's parent (jvnet-parent:1) pinned maven-enforcer-plugin
                         to 1.0, which is no longer cached by bazelbub's offline proxy.
                         Pin the modern 3.x line; we don't actually need enforcer rules
                         for a clean build, but explicitly disable it below. -->
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Match upstream's target=1.5 to preserve Java-5
                         bytecode compatibility for downstream consumers on
                         older JVMs. Our source-level patches
                         (DataSourceWrapper.getParentLogger override and the
                         JAXPExtensionsProvider 1-arg ctor switch) use no
                         Java 7+ syntax, so -source 1.5 still accepts them.
                         A reference to java.sql.SQLFeatureNotSupportedException
                         remains in the .class file: that class only exists
                         from Java 7+, but pre-Java-7 runtimes never call
                         getParentLogger() (CommonDataSource didn't declare
                         it), so the symbolic reference is never resolved on
                         those JVMs. -->
                    <source>1.5</source>
                    <target>1.5</target>
                </configuration>
            </plugin>
            <plugin>
                <!-- Re-declare enforcer here to OVERRIDE the version inherited
                     from jvnet-parent:1's <build><plugins> (which pinned 1.0).
                     pluginManagement alone doesn't win when the parent declares
                     the plugin directly in <plugins>; the child must redeclare
                     in its own <plugins> too. The bazelbub mvn args already
                     pass -Denforcer.skip=true, so the plugin won't execute —
                     we just need it resolvable. -->
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
            </plugin>
            <plugin>
                <!-- impl/pom.xml uses maven-bundle-plugin to generate the OSGi
                     manifest. The version inherited from the upstream parent
                     (6.0.2, class file v61) requires Java 17 to load.
                     For Java-5 bytecode preservation we must use JDK 8, so pin
                     bundle-plugin to 5.1.9 (last Java-8-compatible release). -->
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <version>5.1.9</version>
            </plugin>
        </plugins>
    </build>
    <modules>
        <module>api</module>
        <module>impl</module>
    </modules>
</project>

